<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- 학생 3명 설정 -->
	<bean id="student1" class="mylab.student.di.xml.Student">
		<property name="id" value="S001" />
		<property name="name" value="김민수" />
		<property name="score" value="95" />
	</bean>

	<bean id="student2" class="mylab.student.di.xml.Student">
		<constructor-arg index="0" value="S002" />
		<constructor-arg index="1" value="이영희" />
		<constructor-arg index="2" value="85" />
	</bean>

	<bean id="student3" class="mylab.student.di.xml.Student">
		<property name="id" value="S003" />
		<property name="name" value="박철수" />
		<property name="score" value="75" />
	</bean>

	<!-- Course에 학생 목록 주입 -->
	<bean id="javaCourse" class="mylab.student.di.xml.Course">
		<property name="courseId" value="JAVA001" />
		<property name="courseName" value="자바 프로그래밍" />
		<property name="students">
			<list>
				<ref bean="student1" />
				<ref bean="student2" />
				<ref bean="student3" />
			</list>
		</property>
	</bean>

	<!-- GradeService에 Course 주입 -->
	<bean id="gradeService" class="mylab.student.di.xml.GradeService">
		<property name="course" ref="javaCourse" />
	</bean>

</beans>
